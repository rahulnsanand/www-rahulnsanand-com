# Contact form (see src/app/api/contact/route.ts)
CONTACT_DESTINATION_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sveltia CMS sign-in (see src/app/api/oauth/*).
# Create a GitHub OAuth app with the callback URL <site>/api/oauth/callback and paste the
# credentials here. These are secrets: set them in the hosting dashboard, never commit them.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional. Comma-separated hostnames allowed to start a CMS sign-in and receive a token.
# Wildcards are supported (*.example.com). Defaults to the hostname in src/content/site.json.
# Add localhost only if you want to sign in to the CMS from a local dev server.
CMS_ALLOWED_DOMAINS=www.rahulnsanand.com

# Optional. Overrides src/content/site.json > url for the generated robots/sitemap/llms artifacts.
SITE_URL=
